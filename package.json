{
  "name": "notionflow",
  "version": "0.1.0",
  "description": "Fluid, local-first notes with AI assistance. Your workspace is a folder you own.",
  "private": true,
  "type": "module",
  "main": "out/main/index.mjs",
  "author": "Abhay Tiwari <abhaytiwari0821@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "seed": "node -e \"const { spawnSync } = require('child_process'); const electron = require('electron'); spawnSync(electron, ['scripts/seed-dummy-data.mjs'], { stdio: 'inherit', env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' } });\"",
    "make-icon": "node scripts/make-icon.mjs",
    "predist": "node scripts/kill-running.mjs",
    "dist": "pnpm make-icon && electron-vite build && electron-builder --win",
    "predist:dir": "node scripts/kill-running.mjs",
    "dist:dir": "pnpm make-icon && electron-vite build && electron-builder --win --dir",
    "postdist:dir": "node scripts/sync-release.mjs",
    "app": "dist-win\\win-unpacked\\NotionFlow.exe",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tiptap/extension-collaboration": "^2.27.3",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "better-sqlite3": "^11.10.0",
    "cmdk": "^1.1.1",
    "prosemirror-markdown": "^1.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
